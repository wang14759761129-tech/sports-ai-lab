{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptti.invalid/contracts/match-experience-delta-v0.1.schema.json",
  "title": "PTTI Main match experience additive delta v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "view", "generated_at", "base_catalog_contract", "base_catalog_sha256", "matches", "video_sources", "evidence_sources", "notice"],
  "properties": {
    "contract_version": {"const": "ptti.main.match-experience-delta/0.1"},
    "view": {"const": "STRICT_PUBLIC_EXTERNAL_LINK_DELTA"},
    "generated_at": {"type": "string", "format": "date-time"},
    "base_catalog_contract": {"const": "ptti.match-library-index/0.1"},
    "base_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/match"}},
    "video_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/videoSource"}},
    "evidence_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "notice": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["side", "athlete_id", "name_en"],
      "properties": {"side": {"enum": ["A", "B"]}, "athlete_id": {"type": ["string", "null"]}, "name_en": {"type": "string", "minLength": 1}}
    },
    "rightsMatch": {
      "type": "object", "additionalProperties": false,
      "required": ["public_listing", "evidence_status", "scope", "evidence_source_ids"],
      "properties": {"public_listing": {"const": "ALLOWED"}, "evidence_status": {"const": "FACTUAL_MATCH_METADATA_AND_OFFICIAL_LINK_ONLY"}, "scope": {"const": "MATCH_IDENTITY_AND_OFFICIAL_OUTBOUND_LINK_ONLY"}, "evidence_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
    },
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["match_id", "provider_match_id", "identity_status", "event", "match_type", "round", "participants", "recorded_result", "recorded_winner_id", "result_status", "reference_url", "evidence_source_ids", "video_source_ids", "match_video_link_status", "rights"],
      "properties": {
        "match_id": {"type": "string", "minLength": 1}, "provider_match_id": {"type": "null"}, "identity_status": {"const": "METADATA_CROSSCHECKED_VISUAL_MATCH_NOT_TESTED"},
        "event": {"type": "object", "additionalProperties": false, "required": ["name", "event_id", "date", "competition_level"], "properties": {"name": {"type": "string"}, "event_id": {"type": "string"}, "date": {"type": "null"}, "competition_level": {"type": "string"}}},
        "match_type": {"const": "MS"}, "round": {"const": "UNKNOWN"}, "participants": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/participant"}},
        "recorded_result": {"type": "object", "additionalProperties": false, "required": ["player_a_games", "player_b_games", "game_scores"], "properties": {"player_a_games": {"const": 4}, "player_b_games": {"const": 0}, "game_scores": {"const": [[12, 10], [11, 6], [11, 5], [11, 7]]}}},
        "recorded_winner_id": {"type": "string"}, "result_status": {"const": "OFFICIAL_ITTF_RECAP_CROSSCHECKED"}, "reference_url": {"type": "string", "format": "uri"},
        "evidence_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "video_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "match_video_link_status": {"const": "HUMAN_VERIFIED"}, "rights": {"$ref": "#/$defs/rightsMatch"}
      }
    },
    "rightsVideo": {
      "type": "object", "additionalProperties": false,
      "required": ["public_listing", "external_viewing", "thumbnail_display", "embedding", "download", "local_analysis", "redistribution", "evidence_status", "scope", "evidence_source_ids"],
      "properties": {"public_listing": {"const": "ALLOWED"}, "external_viewing": {"const": "ALLOWED"}, "thumbnail_display": {"const": "NOT_ALLOWED"}, "embedding": {"const": "UNKNOWN"}, "download": {"const": "NOT_GRANTED"}, "local_analysis": {"const": "NOT_GRANTED"}, "redistribution": {"const": "NOT_GRANTED"}, "evidence_status": {"const": "SCOPED_EXTERNAL_LINK_ONLY_NO_MEDIA_USE_GRANT"}, "scope": {"const": "OFFICIAL_YOUTUBE_SHARE_URL_ONLY"}, "evidence_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
    },
    "videoSource": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_record_id", "source_id", "video_id", "platform", "official_url", "watch_entry", "source_published_at", "title", "display_title_zh", "event", "event_display_zh", "event_year", "match_type", "round", "round_zh", "participants_claimed", "publisher", "publisher_url", "source_verified_at", "source_identity_status", "publisher_identity_status", "identity_conflicts", "canonical_match_id", "match_link_status", "content_type_claim", "completeness_status", "rights", "thumbnail", "availability", "provenance"],
      "properties": {
        "catalog_record_id": {"type": "string"}, "source_id": {"type": "string"}, "video_id": {"const": "suwultS-Jcc"}, "platform": {"const": "YOUTUBE"}, "official_url": {"const": "https://www.youtube.com/watch?v=suwultS-Jcc"}, "watch_entry": {"const": "OPEN_OFFICIAL_PLATFORM_URL"}, "source_published_at": {"const": "2025-05-20"},
        "title": {"const": "Wong Chun Ting vs Wang Chuqin | Match Highlights | #ITTFWorlds2025"}, "display_title_zh": {"type": "null"}, "event": {"type": "string"}, "event_display_zh": {"type": "null"}, "event_year": {"const": 2025}, "match_type": {"const": "MS"}, "round": {"const": "UNKNOWN"}, "round_zh": {"type": "null"},
        "participants_claimed": {"type": "object", "additionalProperties": false, "required": ["side_a", "side_b"], "properties": {"side_a": {"type": "string"}, "side_b": {"type": "string"}}},
        "publisher": {"const": "World Table Tennis"}, "publisher_url": {"const": "https://www.youtube.com/@wttglobal"}, "source_verified_at": {"type": "string", "format": "date-time"}, "source_identity_status": {"const": "VERIFIED"}, "publisher_identity_status": {"const": "VERIFIED"}, "identity_conflicts": {"type": "array", "maxItems": 0},
        "canonical_match_id": {"type": "string"}, "match_link_status": {"const": "HUMAN_VERIFIED"}, "content_type_claim": {"const": "HIGHLIGHTS"}, "completeness_status": {"const": "UNVERIFIED"}, "rights": {"$ref": "#/$defs/rightsVideo"},
        "thumbnail": {"type": "object", "additionalProperties": false, "required": ["url", "source_has_thumbnail_url", "display_status"], "properties": {"url": {"type": "null"}, "source_has_thumbnail_url": {"const": false}, "display_status": {"const": "NOT_DISPLAYED"}}},
        "availability": {"type": "object", "additionalProperties": false, "required": ["official_page_current", "external_video_visual_latest_recorded", "external_observations", "platform_embed", "desktop_native_playback", "vision_analysis", "current_session_eligibility", "latest_recorded_playback_status", "territory_availability", "recorded_region_restriction", "login_or_paywall"], "properties": {
          "official_page_current": {"const": "NOT_TESTED"}, "external_video_visual_latest_recorded": {"const": "NOT_TESTED"}, "external_observations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["surface", "checked_at", "page_accessible", "visual_playback", "observed_result", "limitations"], "properties": {"surface": {"const": "OFFICIAL_YOUTUBE_METADATA_SEARCH_RESULT"}, "checked_at": {"type": "string", "format": "date-time"}, "page_accessible": {"type": "null"}, "visual_playback": {"const": "NOT_TESTED"}, "observed_result": {"type": "string"}, "limitations": {"type": "string"}}}},
          "platform_embed": {"type": "object", "additionalProperties": false, "required": ["permission", "latest_recorded_technical_status", "historical_attempts"], "properties": {"permission": {"const": "UNKNOWN"}, "latest_recorded_technical_status": {"const": "NOT_TESTED"}, "historical_attempts": {"type": "array", "maxItems": 0}}},
          "desktop_native_playback": {"const": "NOT_TESTED"}, "vision_analysis": {"const": "NOT_TESTED"}, "current_session_eligibility": {"const": "NOT_EVALUATED_CURRENT_SESSION"}, "latest_recorded_playback_status": {"const": "NOT_TESTED"}, "territory_availability": {"const": "UNKNOWN"}, "recorded_region_restriction": {"const": "UNKNOWN"}, "login_or_paywall": {"const": "NOT_TESTED"}
        }},
        "provenance": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["recorded_at", "metadata_method", "source_id", "source_rights_scope", "playback_status_recorded"], "properties": {"recorded_at": {"type": "string", "format": "date-time"}, "metadata_method": {"type": "string"}, "source_id": {"type": "string"}, "source_rights_scope": {"const": "OFFICIAL_YOUTUBE_SHARE_URL_ONLY"}, "playback_status_recorded": {"const": "NOT_TESTED"}}}}
      }
    },
    "evidence": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_type", "url", "retrieved_at", "description"], "properties": {"source_id": {"type": "string"}, "source_type": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "retrieved_at": {"type": "string", "format": "date-time"}, "description": {"type": "string"}}}
  }
}
