{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptti.invalid/contracts/match-library-index-v0.1.schema.json",
  "title": "PTTI Match Library Index v0.1",
  "type": "object",
  "required": ["contract_version", "view", "generated_at", "source_manifest", "matches", "video_sources", "local_video_assets", "stars", "evidence_sources", "quality_summary", "analysis_compatibility", "notice"],
  "properties": {
    "contract_version": {"const": "ptti.match-library-index/0.1"},
    "view": {"enum": ["INTERNAL_REVIEW", "STRICT_PUBLIC"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_manifest": {"type": "array", "items": {"type": "object", "required": ["file", "sha256"], "properties": {"file": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "matches": {"type": "array", "items": {"$ref": "#/$defs/match"}},
    "video_sources": {"type": "array", "items": {"$ref": "#/$defs/videoSource"}},
    "local_video_assets": {"type": "array", "maxItems": 0},
    "stars": {"type": "array", "items": {"$ref": "#/$defs/star"}},
    "evidence_sources": {"type": "array", "items": {"$ref": "#/$defs/evidenceSource"}},
    "rights_review_queue": {"type": "array", "items": {"type": "object", "required": ["record_type", "record_id", "pending_evidence"], "properties": {"record_type": {"enum": ["VIDEO_SOURCE", "MATCH", "ATHLETE_PROFILE"]}, "record_id": {"type": "string"}, "pending_evidence": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "quality_summary": {"type": "object"},
    "analysis_compatibility": {"type": "object", "required": ["review_targets_version", "review_evidence_pack_version", "join_policy", "automatic_join_by_title_or_player_name", "playback_eligibility"], "properties": {"review_targets_version": {"const": "ptti.review-targets/0.1"}, "review_evidence_pack_version": {"const": "ptti.review-evidence-pack/0.1"}, "join_policy": {"const": "EXACT_MATCH_ID_AND_SOURCE_ID_WITH_EVIDENCE_ONLY"}, "automatic_join_by_title_or_player_name": {"const": false}, "playback_eligibility": {"const": "NOT_EVALUATED_CURRENT_SESSION"}, "catalog_sources_linked_to_review_data": {"type": "integer", "minimum": 0}}, "additionalProperties": true},
    "notice": {"type": "string"}
  },
  "$defs": {
    "match": {"type": "object", "required": ["match_id", "identity_status", "event", "match_type", "round", "participants", "recorded_result", "result_status", "reference_url", "evidence_source_ids", "video_source_ids", "match_video_link_status", "rights"], "properties": {"match_id": {"type": "string"}, "identity_status": {"type": "string"}, "event": {"type": "object"}, "match_type": {"enum": ["MS", "WS", "MD", "WD", "XD", "UNKNOWN"]}, "round": {"type": "string"}, "participants": {"type": "array"}, "recorded_result": {"type": ["object", "null"]}, "result_status": {"type": "string"}, "reference_url": {"type": ["string", "null"], "format": "uri"}, "evidence_source_ids": {"type": "array", "items": {"type": "string"}}, "video_source_ids": {"type": "array", "items": {"type": "string"}}, "match_video_link_status": {"enum": ["UNKNOWN", "HUMAN_VERIFIED"]}, "rights": {"type": "object"}}, "additionalProperties": true},
    "videoSource": {"type": "object", "required": ["catalog_record_id", "source_id", "video_id", "platform", "official_url", "watch_entry", "title", "event", "event_year", "match_type", "round", "participants_claimed", "publisher", "source_verified_at", "source_identity_status", "identity_conflicts", "canonical_match_id", "match_link_status", "content_type_claim", "completeness_status", "rights", "thumbnail", "availability", "provenance"], "properties": {"catalog_record_id": {"type": "string"}, "source_id": {"type": "string"}, "video_id": {"type": "string"}, "platform": {"enum": ["YOUTUBE", "BILIBILI"]}, "official_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "watch_entry": {"const": "OPEN_OFFICIAL_PLATFORM_URL"}, "title": {"type": "string"}, "original_title": {"type": "string"}, "event": {"type": "string"}, "event_year": {"type": ["integer", "null"]}, "match_date": {"type": ["string", "null"]}, "match_type": {"enum": ["MS", "WS", "MD", "WD", "XD", "UNKNOWN"]}, "round": {"type": "string"}, "participants_claimed": {"type": "object"}, "publisher": {"type": "string"}, "publisher_url": {"type": ["string", "null"], "format": "uri"}, "source_verified_at": {"type": ["string", "null"]}, "publisher_identity_status": {"type": "string"}, "source_identity_status": {"type": "string"}, "identity_conflicts": {"type": "array", "items": {"type": "string"}}, "canonical_match_id": {"type": ["string", "null"]}, "match_link_status": {"enum": ["UNKNOWN", "HUMAN_VERIFIED"]}, "content_type_claim": {"enum": ["FULL_MATCH", "HIGHLIGHTS", "SESSION", "CLIP", "UNKNOWN"]}, "completeness_status": {"enum": ["VERIFIED", "UNVERIFIED"]}, "permission_status_recorded": {"type": "string"}, "rights": {"type": "object", "required": ["public_listing", "external_viewing", "thumbnail_display", "embedding", "local_analysis", "redistribution"], "properties": {"public_listing": {"enum": ["ALLOWED", "NOT_ALLOWED", "UNKNOWN"]}, "external_viewing": {"enum": ["ALLOWED", "NOT_ALLOWED", "UNKNOWN"]}, "thumbnail_display": {"enum": ["ALLOWED", "NOT_ALLOWED", "UNKNOWN"]}, "embedding": {"enum": ["ALLOWED", "NOT_ALLOWED", "UNKNOWN"]}, "local_analysis": {"enum": ["ALLOWED", "NOT_GRANTED", "NOT_ALLOWED", "UNKNOWN"]}, "redistribution": {"enum": ["ALLOWED", "NOT_GRANTED", "NOT_ALLOWED", "UNKNOWN"]}}, "additionalProperties": true}, "thumbnail": {"type": "object", "required": ["url", "source_has_thumbnail_url", "display_status"], "properties": {"url": {"type": "null"}, "source_has_thumbnail_url": {"type": "boolean"}, "display_status": {"type": "string"}}, "additionalProperties": false}, "availability": {"type": "object", "required": ["official_page_current", "external_video_visual_latest_recorded", "external_observations", "platform_embed", "desktop_native_playback", "vision_analysis", "current_session_eligibility", "latest_recorded_playback_status", "territory_availability"], "properties": {"official_page_current": {"const": "NOT_TESTED"}, "external_video_visual_latest_recorded": {"type": "string"}, "external_observations": {"type": "array"}, "platform_embed": {"type": "object"}, "desktop_native_playback": {"enum": ["PASS", "NOT_TESTED"]}, "vision_analysis": {"const": "NOT_TESTED"}, "current_session_eligibility": {"const": "NOT_EVALUATED_CURRENT_SESSION"}, "latest_recorded_playback_status": {"type": "string"}, "territory_availability": {"type": "string"}}, "additionalProperties": true}, "provenance": {"type": "array", "items": {"type": "object"}}, "snapshot_count": {"type": "integer", "minimum": 1}}, "additionalProperties": true},
    "star": {"type": "object", "required": ["athlete_id", "name_en", "name_zh", "association", "official_profile_url", "evidence_source_ids", "public_listing", "equipment", "coach_observations", "interviews", "sponsorships", "social_feedback"], "properties": {"athlete_id": {"type": "string"}, "name_en": {"type": ["string", "null"]}, "name_zh": {"type": ["string", "null"]}, "association": {"type": ["string", "null"]}, "official_profile_url": {"type": ["string", "null"], "format": "uri"}, "profile_last_verified_at": {"type": ["string", "null"]}, "evidence_source_ids": {"type": "array", "items": {"type": "string"}}, "public_listing": {"enum": ["ALLOWED", "NOT_ALLOWED", "UNKNOWN"]}, "equipment": {"type": "object", "required": ["status", "items"], "properties": {"status": {"const": "UNKNOWN"}, "items": {"type": "array", "maxItems": 0}}, "additionalProperties": false}, "coach_observations": {"type": "object"}, "interviews": {"type": "object"}, "sponsorships": {"type": "object"}, "social_feedback": {"type": "object"}}, "additionalProperties": true},
    "evidenceSource": {"type": "object", "required": ["source_id", "source_type", "url", "retrieved_at", "description"], "properties": {"source_id": {"type": "string"}, "source_type": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "retrieved_at": {"type": ["string", "null"]}, "description": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
