{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptti.invalid/contracts/cinema-source-review-v0.1.schema.json",
  "title": "PTTI Cinema Source Review v0.1 (internal only)",
  "type": "object",
  "required": ["contract_version", "source_contract_version", "input_contract_version", "audience", "generated_at", "catalog_snapshot", "summary", "featured_sources", "notice"],
  "properties": {
    "contract_version": {"const": "ptti.cinema-source-review/0.1"},
    "source_contract_version": {"const": "ptti.match-library-index/0.1"},
    "input_contract_version": {"const": "ptti.cinema-source-review-input/0.1"},
    "audience": {"const": "INTERNAL_REVIEW_ONLY"},
    "generated_at": {"type": "string", "format": "date-time"},
    "catalog_snapshot": {
      "type": "object", "required": ["unique_video_sources", "registered_match_records", "canonical_video_match_links", "strict_public_video_source_count"],
      "properties": {"unique_video_sources": {"type": "integer", "minimum": 0}, "registered_match_records": {"type": "integer", "minimum": 0}, "canonical_video_match_links": {"type": "integer", "minimum": 0}, "strict_public_video_source_count": {"const": 0}},
      "additionalProperties": false
    },
    "summary": {
      "type": "object", "required": ["selected_sources", "official_pages_http_200", "external_visual_playback_pass", "canonical_match_links", "public_projection_fallback"],
      "properties": {"selected_sources": {"type": "integer", "minimum": 1, "maximum": 3}, "official_pages_http_200": {"type": "integer", "minimum": 0, "maximum": 3}, "external_visual_playback_pass": {"const": 0}, "canonical_match_links": {"const": 0}, "public_projection_fallback": {"const": false}},
      "additionalProperties": false
    },
    "featured_sources": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/source"}},
    "notice": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "permission": {"enum": ["ALLOWED", "NOT_ALLOWED", "NOT_GRANTED", "UNKNOWN"]},
    "source": {
      "type": "object",
      "required": ["source_id", "catalog_record_id", "video_id", "platform", "original_source_url", "watch_entry", "publisher_metadata", "match_claim", "match_link", "watch_status", "content_claim", "rights", "thumbnail", "audience", "next_evidence_needed"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1}, "catalog_record_id": {"type": "string", "minLength": 1}, "video_id": {"type": "string", "minLength": 1},
        "platform": {"const": "YOUTUBE"}, "original_source_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.youtube\\.com/watch\\?v="},
        "watch_entry": {"const": "OPEN_OFFICIAL_PLATFORM_URL"},
        "publisher_metadata": {"$ref": "#/$defs/publisher"}, "match_claim": {"$ref": "#/$defs/matchClaim"}, "match_link": {"$ref": "#/$defs/matchLink"},
        "watch_status": {"$ref": "#/$defs/watchStatus"}, "content_claim": {"$ref": "#/$defs/contentClaim"}, "rights": {"$ref": "#/$defs/rights"}, "thumbnail": {"$ref": "#/$defs/thumbnail"},
        "audience": {"const": "INTERNAL_REVIEW_ONLY"}, "next_evidence_needed": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }, "additionalProperties": false
    },
    "publisher": {
      "type": "object", "required": ["method", "checked_at", "title", "author_name", "author_url", "status"],
      "properties": {"method": {"const": "YOUTUBE_OEMBED_SINGLE_LOOKUP"}, "checked_at": {"type": "string", "format": "date-time"}, "title": {"type": "string"}, "author_name": {"type": "string"}, "author_url": {"type": "string", "format": "uri"}, "status": {"const": "MATCHES_SNAPSHOT_METADATA_AFFILIATION_AND_RIGHTS_SCOPE_NOT_PROVEN"}}, "additionalProperties": false
    },
    "matchClaim": {
      "type": "object", "required": ["event_name", "event_year", "discipline", "round", "participants", "status", "match_date", "event_window", "evidence_sources", "official_source_references_video_id"],
      "properties": {
        "event_name": {"type": "string"}, "event_year": {"type": "integer"}, "discipline": {"enum": ["MS", "WS", "MD", "WD", "XD"]}, "round": {"type": "string"}, "participants": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"}}, "status": {"type": "string"},
        "match_date": {"type": "object", "required": ["value", "status", "local_start_time"], "properties": {"value": {"type": ["string", "null"], "format": "date"}, "status": {"enum": ["OFFICIAL_REPORT_DATE", "SECONDARY_CATALOG_ONLY", "UNKNOWN"]}, "local_start_time": {"type": "null"}}, "additionalProperties": false},
        "event_window": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["start", "end", "status"], "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}, "status": {"const": "OFFICIAL_EVENT_INFO"}}, "additionalProperties": false}]},
        "evidence_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "official_source_references_video_id": {"const": false}
      }, "additionalProperties": false
    },
    "evidence": {"type": "object", "required": ["role", "url", "claims"], "properties": {"role": {"enum": ["OFFICIAL_MATCH_RESULT", "OFFICIAL_EVENT_INFO", "SECONDARY_STREAMING_CATALOG"]}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "matchLink": {"type": "object", "required": ["canonical_match_id", "status", "unlinked_review_candidate_match_id", "reason", "join_policy"], "properties": {"canonical_match_id": {"type": "null"}, "status": {"const": "UNKNOWN"}, "unlinked_review_candidate_match_id": {"type": ["string", "null"]}, "reason": {"type": "string"}, "join_policy": {"const": "EXACT_EVIDENCE_REQUIRED_NO_AUTOMATIC_JOIN_BY_TITLE_EVENT_OR_PLAYER_NAME"}}, "additionalProperties": false},
    "watchStatus": {"type": "object", "required": ["official_page_request", "page_checked_at", "external_visual_video_playback", "external_viewing_rights", "territory_status", "login_or_region_check", "in_app_embedding_permission", "latest_recorded_embed_technical_status", "in_app_entry", "unavailability_or_limit_reason"], "properties": {"official_page_request": {"enum": ["HTTP_200_PAGE_ONLY", "HTTP_NON_200_REVIEW_REQUIRED"]}, "page_checked_at": {"type": "string", "format": "date-time"}, "external_visual_video_playback": {"const": "NOT_TESTED"}, "external_viewing_rights": {"$ref": "#/$defs/permission"}, "territory_status": {"type": "string"}, "login_or_region_check": {"const": "NOT_TESTED"}, "in_app_embedding_permission": {"$ref": "#/$defs/permission"}, "latest_recorded_embed_technical_status": {"type": "string"}, "in_app_entry": {"const": "EXTERNAL_ONLY_PERMISSION_UNVERIFIED"}, "unavailability_or_limit_reason": {"type": "string"}}, "additionalProperties": false},
    "contentClaim": {"type": "object", "required": ["publisher_title_claim", "completeness", "completeness_status"], "properties": {"publisher_title_claim": {"enum": ["FULL_MATCH", "HIGHLIGHTS", "SESSION", "CLIP", "UNKNOWN"]}, "completeness": {"enum": ["VERIFIED", "UNVERIFIED"]}, "completeness_status": {"const": "UNVERIFIED_TITLE_IS_NOT_COMPLETENESS_EVIDENCE"}}, "additionalProperties": false},
    "rights": {"type": "object", "required": ["public_listing", "external_viewing", "thumbnail_display", "embedding", "local_analysis", "redistribution"], "properties": {"public_listing": {"$ref": "#/$defs/permission"}, "external_viewing": {"$ref": "#/$defs/permission"}, "thumbnail_display": {"$ref": "#/$defs/permission"}, "embedding": {"$ref": "#/$defs/permission"}, "local_analysis": {"$ref": "#/$defs/permission"}, "redistribution": {"$ref": "#/$defs/permission"}}, "additionalProperties": false},
    "thumbnail": {"type": "object", "required": ["url", "display_permission", "presentation"], "properties": {"url": {"type": "null"}, "display_permission": {"$ref": "#/$defs/permission"}, "presentation": {"const": "PTTI_BRAND_PLACEHOLDER_ONLY"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
