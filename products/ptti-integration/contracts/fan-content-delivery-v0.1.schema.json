{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptti.local/contracts/fan-content-delivery-v0.1.schema.json",
  "title": "PTTI Fan Content Delivery v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "view", "base_contract_version", "generated_at", "source_manifest", "stars", "events", "matches", "clips", "watch_sources", "relationships", "relationship_gaps", "source_index", "quality_summary", "notice"],
  "properties": {
    "contract_version": {"const": "ptti.fan-content-delivery/0.1"},
    "view": {"const": "INTERNAL_REVIEW"},
    "base_contract_version": {"const": "ptti.fan-content-intelligence/0.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_manifest": {"type": "object", "additionalProperties": false, "required": ["base_dataset_sha256", "localization_sha256"], "properties": {"base_dataset_sha256": {"$ref": "#/$defs/sha256"}, "localization_sha256": {"$ref": "#/$defs/sha256"}}},
    "stars": {"type": "array", "items": {"type": "object", "required": ["athlete_id", "name_en", "name_zh", "official_profile_url", "public_listing"], "properties": {"athlete_id": {"type": "string"}, "name_en": {"type": "string"}, "name_zh": {"type": ["string", "null"]}, "official_profile_url": {"type": ["string", "null"], "format": "uri"}, "public_listing": {"const": "UNKNOWN"}}, "additionalProperties": true}},
    "events": {"type": "array", "items": {"type": "object", "required": ["event_id", "title_original", "title_zh", "translation_origin", "official_translation_status", "official_event_page_url", "rights", "public_status"], "properties": {"event_id": {"type": "string"}, "title_original": {"type": "string"}, "title_zh": {"type": "string", "minLength": 1}, "translation_origin": {"const": "PTTI_EDITORIAL_TRANSLATION"}, "official_translation_status": {"const": "UNKNOWN"}, "official_event_page_url": {"type": "string", "format": "uri"}, "public_status": {"const": "INTERNAL_ONLY_PENDING_RIGHTS_REVIEW"}, "rights": {"$ref": "#/$defs/rights"}}, "additionalProperties": true}},
    "matches": {"type": "array", "maxItems": 0},
    "clips": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["clip_id", "event_id", "match_id", "match_link_status", "title_original", "title_zh", "translation_origin", "official_translation_status", "content_type", "provider", "video_id", "official_video_url", "publisher", "publisher_identity_status", "published_at", "publication_date_status", "page_observation_status", "watch_source_id", "source_evidence_ids", "source_verified_at", "playback_status", "territory", "login_or_paywall", "embed_status", "thumbnail_url", "public_status", "rights"], "properties": {"clip_id": {"type": "string"}, "event_id": {"type": "string"}, "match_id": {"type": ["string", "null"]}, "match_link_status": {"const": "UNKNOWN"}, "title_original": {"type": "string"}, "title_zh": {"type": "string", "minLength": 1}, "translation_origin": {"const": "PTTI_EDITORIAL_TRANSLATION"}, "official_translation_status": {"const": "UNKNOWN"}, "content_type": {"type": "string"}, "provider": {"type": "string"}, "video_id": {"type": ["string", "null"]}, "official_video_url": {"type": ["string", "null"], "format": "uri"}, "publisher": {"type": ["string", "null"]}, "publisher_identity_status": {"type": "string"}, "published_at": {"type": ["string", "null"]}, "publication_date_status": {"type": "string"}, "page_observation_status": {"type": "string"}, "watch_source_id": {"type": "string"}, "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "source_verified_at": {"type": "string"}, "playback_status": {"const": "NOT_TESTED"}, "territory": {"const": "UNKNOWN"}, "login_or_paywall": {"const": "NOT_TESTED"}, "embed_status": {"const": "UNKNOWN"}, "thumbnail_url": {"type": ["string", "null"], "format": "uri"}, "public_status": {"const": "INTERNAL_ONLY_PENDING_RIGHTS_REVIEW"}, "rights": {"$ref": "#/$defs/rights"}}}},
    "watch_sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["watch_source_id", "provider", "route_kind", "url", "route_status", "evidence_ids", "current_access", "playback_status", "territory", "login_or_paywall", "embed_status", "rights"], "properties": {"watch_source_id": {"type": "string"}, "provider": {"type": "string"}, "route_kind": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "route_status": {"enum": ["URL_IDENTIFIED_PLAYBACK_NOT_TESTED", "OFFICIAL_LISTING_ONLY_VIDEO_URL_UNRESOLVED"]}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "current_access": {"const": "NOT_TESTED_CURRENT_SESSION"}, "playback_status": {"const": "NOT_TESTED"}, "territory": {"const": "UNKNOWN"}, "login_or_paywall": {"const": "NOT_TESTED"}, "embed_status": {"const": "UNKNOWN"}, "rights": {"$ref": "#/$defs/rights"}}}},
    "relationships": {"type": "array", "items": {"type": "object", "required": ["relationship_id", "from_type", "from_id", "to_type", "to_id", "relationship_kind", "evidence_ids", "edge_status"], "properties": {"relationship_id": {"type": "string"}, "from_type": {"type": "string"}, "from_id": {"type": "string"}, "to_type": {"type": "string"}, "to_id": {"type": "string"}, "relationship_kind": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "edge_status": {"type": "string"}}, "additionalProperties": true}},
    "relationship_gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "status", "reason"], "properties": {"path": {"enum": ["STAR_TO_MATCH", "MATCH_TO_CLIP"]}, "status": {"const": "NOT_ESTABLISHED"}, "reason": {"type": "string", "minLength": 1}}}},
    "source_index": {"type": "array", "items": {"type": "object", "required": ["evidence_id", "kind", "url", "observed_at", "claims", "limitations"], "properties": {"evidence_id": {"type": "string"}, "kind": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "observed_at": {"type": "string"}, "claims": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "string"}}, "additionalProperties": true}},
    "quality_summary": {"type": "object", "additionalProperties": false, "required": ["star_count", "event_count", "verified_match_count", "clip_candidate_count", "unique_watch_source_count", "exact_video_url_count", "event_page_only_count", "playback_pass_count", "public_eligible_count", "match_video_links"], "properties": {"star_count": {"type": "integer", "minimum": 0}, "event_count": {"type": "integer", "minimum": 0}, "verified_match_count": {"const": 0}, "clip_candidate_count": {"type": "integer", "minimum": 0}, "unique_watch_source_count": {"type": "integer", "minimum": 0}, "exact_video_url_count": {"type": "integer", "minimum": 0}, "event_page_only_count": {"type": "integer", "minimum": 0}, "playback_pass_count": {"const": 0}, "public_eligible_count": {"const": 0}, "match_video_links": {"const": 0}}},
    "notice": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rights": {"type": "object", "required": ["public_listing", "external_viewing", "embedding", "thumbnail_display", "local_analysis", "download", "redistribution", "evidence_status", "notes"], "properties": {"public_listing": {"const": "UNKNOWN"}, "external_viewing": {"const": "UNKNOWN"}, "embedding": {"const": "UNKNOWN"}, "thumbnail_display": {"const": "UNKNOWN"}, "local_analysis": {"const": "NOT_GRANTED"}, "download": {"const": "NOT_GRANTED"}, "redistribution": {"const": "NOT_GRANTED"}, "evidence_status": {"const": "NO_SCOPED_GRANT_RECORDED"}, "notes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  }
}
